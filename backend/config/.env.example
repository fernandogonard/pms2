# ============================================================
# CRM Hotelero — Variables de entorno
# Copiar este archivo como: backend/config/.env
# NUNCA commitear el archivo .env real con valores reales
# ============================================================

# --- Base de datos ---
# Desarrollo local:
MONGO_URI=mongodb://localhost:27017/crm-hotelero
# Producción (MongoDB Atlas) — reemplazar con tu connection string:
# MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/crm-hotelero?retryWrites=true&w=majority&appName=CRMHotelero

# --- Servidor ---
PORT=5000
NODE_ENV=development
# NODE_ENV=production

# --- Autenticación JWT ---
# OBLIGATORIO en producción: generar con: node -e "require('crypto').randomBytes(64).toString('hex') |% { Write-Host $_ }"
JWT_SECRET=CAMBIAR_POR_SECRET_SEGURO_MINIMO_64_CHARS
JWT_REFRESH_SECRET=CAMBIAR_POR_REFRESH_SECRET_DIFERENTE_MINIMO_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Desarrollo:
CORS_ORIGIN=http://localhost:3000
# Producción (URL de tu frontend en Vercel):
# CORS_ORIGIN=https://tu-hotel.vercel.app

# --- WebSocket ---
WS_LOG_LEVEL=warn

# --- Mercado Pago ---
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# En producción reemplazar TEST- por token productivo
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_webhook_secret_mercadopago
# URL base del backend (para webhooks y back_urls)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# --- Emails transaccionales (Nodemailer) ---
# Opción 1: Gmail con App Password (recomendado para bajo volumen)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM="Hotel Diva <noreply@hoteldiva.com>"
# Opción 2: SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.xxxxxxxxxx

# --- Hotel (datos para emails y facturas) ---
HOTEL_NAME=Hotel Diva
HOTEL_ADDRESS=Mar del Plata, Buenos Aires, Argentina
HOTEL_PHONE=+54 223 xxx-xxxx
HOTEL_EMAIL=info@hoteldiva.com
HOTEL_WEBSITE=https://hoteldiva.com

# --- Monitoreo (opcional) ---
# SENTRY_DSN=https://xxx@sentry.io/xxx

# --- Logs ---
LOG_LEVEL=info
# LOG_LEVEL=debug  (más detallado, solo para desarrollo)

# --- Rate Limiting (opcional, usa defaults si no se define) ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=1000
